{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/i18n": ["./i18n/index.ts"],
      "content-collections": ["./.content-collections/generated/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "content-collections.ts",
    "i18n/**/*.ts",
    "i18n/paraglide/**/*.js"
  ]
}
