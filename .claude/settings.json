{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:react)",
      "Bash(pnpm format)",
      "Bash(pnpm check-all)",
      "Bash(pnpm build)",
      "Bash(pnpm codegen)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm docker:up)",
      "Bash(pnpm bootstrap)",
      "Bash(pnpm --filter @repo/web test)",
      "Bash(pnpm --filter @repo/web test:*)",
      "Bash(pnpm --filter @repo/web typecheck)",
      "Bash(pnpm --filter @repo/shared test)",
      "Bash(pnpm --filter @repo/shared test:*)",
      "Bash(pnpm --filter @repo/shared typecheck)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec vitest run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-generated-writes.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/biome-after-write.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
