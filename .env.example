# Copy this file to .env at the repository root. The web app, database tools,
# and optional Python service all read this single file.
#
# Local development requires only DATABASE_URL and BETTER_AUTH_SECRET. Optional
# variables are commented out so their safe defaults remain in effect.
#
# Never commit .env. Variables prefixed with VITE_ are public and are bundled
# into browser code; never use that prefix for passwords, tokens, or secrets.

# =============================================================================
# Shared database
# =============================================================================

# PostgreSQL connection used by the web app, Drizzle migrations, seeds, resets,
# and backfills. This matches the database started by `pnpm docker:up`.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/webapp"

# =============================================================================
# Web application runtime
# =============================================================================

# Runtime mode: development | test | production. Build and deployment tooling
# normally sets this automatically.
# NODE_ENV="development"

# Port used by the production Node server. The Vite development server always
# uses 3000; hosting platforms commonly inject PORT themselves.
# PORT="3000"

# Pino log severity floor: trace | debug | info | warn | error | fatal.
# LOG_LEVEL="info"

# =============================================================================
# Public web build configuration
# =============================================================================

# Canonical public origin used for SEO metadata and sitemap URLs. Set this at
# build time for staging and production, and keep it aligned with
# BETTER_AUTH_URL. Defaults to http://localhost:3000.
# VITE_SITE_ORIGIN="http://localhost:3000"

# Only production should opt into search indexing. Local, preview, and staging
# environments should remain false. This value is baked into the build.
# VITE_SEO_INDEXABLE="false"

# Optional PostHog project key. This is a public write-only key, not a secret.
# When absent, PostHog is not initialized or loaded by the browser.
# VITE_POSTHOG_KEY="phc_your_project_key"

# =============================================================================
# Authentication (Better Auth)
# =============================================================================

# Public origin Better Auth trusts and uses for email and OAuth links. It must
# exactly match the deployed origin, including scheme and port. The local
# default is http://localhost:3000.
# BETTER_AUTH_URL="http://localhost:3000"

# Session-signing secret. Use a distinct value in every environment. Generate
# one with `openssl rand -base64 32`; never prefix it with VITE_.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Configure both values to enable the provider; leave both absent to disable it.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub OAuth: https://github.com/settings/developers
# Configure both values to enable the provider; leave both absent to disable it.
# GitHub OAuth Apps allow one callback URL, so use a separate app per environment.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID="your_github_client_id"
# GITHUB_CLIENT_SECRET="your_github_client_secret"

# Protects POST /api/internal/auth-cleanup via the x-cleanup-secret header.
# The endpoint stays unavailable when this is absent. Minimum 32 characters.
# AUTH_CLEANUP_SECRET="replace-with-a-random-cleanup-secret"

# =============================================================================
# Transactional email (Resend)
# =============================================================================

# Delivery mode: log | resend | disabled.
#   log      prints local magic links without contacting an email provider
#   resend   sends transactional email and requires RESEND_API_KEY
#   disabled intentionally skips all delivery
# EMAIL_MODE="log"

# Required only when EMAIL_MODE=resend. Use a separate key and verified sending
# domain for each deployed environment.
# RESEND_API_KEY="re_your_api_key"

# =============================================================================
# Optional Python service
# =============================================================================

# Deployment label available to the FastAPI service configuration.
# ENVIRONMENT="development"

# HMAC secret required by every Python service route except /health. The local default
# is for development only; set a unique value of at least 32 characters in
# deployed environments and give it to the server-side caller that signs requests.
# PYTHON_SERVICE_SIGNING_SECRET="replace-with-a-random-python-service-secret"

# Comma-separated browser origins allowed by the Python service's CORS middleware.
# Server-to-server requests do not depend on CORS.
# ALLOWED_ORIGINS="http://localhost:3000"
