{
  "name": "@repo/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./db/index": {
      "types": "./src/db/index.ts",
      "import": "./src/db/index.ts"
    },
    "./db/client": null,
    "./db/test-db": null,
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "node --import ../../scripts/with-env.mjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.js",
    "db:migrate:deploy": "node scripts/migrate.js",
    "db:push": "node --import ../../scripts/with-env.mjs ./node_modules/drizzle-kit/bin.cjs push",
    "db:reset": "tsx --env-file-if-exists=../../.env scripts/db-reset.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env seed/seed.ts",
    "db:studio": "node --import ../../scripts/with-env.mjs ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
